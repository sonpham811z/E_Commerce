# Server
PORT=3002
NODE_ENV=development

# Database (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.ap-southeast-1.aws.neon.tech/ai_db?sslmode=require
DB_SSL=true
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# Auth Service (for JWT verification)
AUTH_SERVICE_URL=http://localhost:3001

# Groq LLM API
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-8b-8192
GROQ_MAX_TOKENS=1024

# Core Service (for product data in recommendations)
CORE_SERVICE_URL=http://localhost:3003

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Chat
MAX_CHAT_HISTORY=50
