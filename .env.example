# Neon database URLs for each backend service
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.ap-southeast-1.aws.neon.tech/auth_db?sslmode=require
AI_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.ap-southeast-1.aws.neon.tech/ai_db?sslmode=require
CORE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.ap-southeast-1.aws.neon.tech/core_db?sslmode=require

# Backend service URLs used by the frontend and service-to-service calls
VITE_AUTH_SERVICE_URL=http://localhost:3001
VITE_AI_SERVICE_URL=http://localhost:3002
VITE_CORE_SERVICE_URL=http://localhost:3003